# Binance API(USDC 永续合约)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# 监控的交易对 / 周期
# USDC 永续合约(对齐 pinbar-detector) — 用 @kline_{tf} 频道
SYMBOL=btcusdc
TIMEFRAME=15m

# Wick SR 检测阈值
WICK_RATIO=0.4          # wick 占整 K range 的最小比例(>= 0.4)
LOOKBACK_CANDLES=300     # 拉多少根 K 线做回溯

# 下单参数
POSITION_PCT=0.5         # 单仓占余额比例(保证金 = balance × pct)
LEVERAGE_DEFAULT=100     # 查不到 leverage 时的 fallback(默认 100x)
STOP_LOSS_USD=200        # 止损 USD 距离
TAKE_PROFIT_RR=1.0       # 止盈倍数 = STOP_LOSS_USD × RR(默认 1.0 = 1:1)
REVERSAL_ENTRY_OFFSET_USD=200  # 反转 wick 入场偏移:做多=min(s.level+offset, close),做空=max(s.level-offset, close)
MAX_OPEN_ORDERS=1        # 同 symbol 同时持仓数上限,默认 1=有仓位不开新单
ALERT_COOLDOWN_MIN=15    # 同一根 K 同侧报警冷却(分钟),0 = 关闭
HQ_TRADE_HOUR_START=20    # 20-23 北京(纽约时段)高等级同向 wick 也下单
HQ_TRADE_HOUR_END=23

# 保护性止损(参考 pinbar-detector monitor_positions 风格):
# 浮盈 ≥ PROTECTIVE_ACTIVATION_POINTS(默认 100 USD)→ 把 SL 替换为 entry ± PROTECTIVE_STOP_POINTS(默认 20 USD)
# 用 mark_price 算 profit(不含手续费 / funding);tolerance = 0.5 * tickSize;replace 而非加新
PROTECTIVE_ACTIVATION_POINTS=100  # 触发阈值(mark_price - entry 浮盈 ≥)
PROTECTIVE_STOP_POINTS=20         # 新 SL 距 entry 的距离(LONG: entry+20,SHORT: entry-20)
PROTECTIVE_INTERVAL_SECS=60       # 后台 task 检查周期

# 钉钉 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=xxx

# Telegram(可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
