# Binance API(USDC 永续合约)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# 监控的交易对 / 周期
# USDC 永续合约(对齐 pinbar-detector) — 用 @kline_{tf} 频道
SYMBOL=btcusdc
TIMEFRAME=15m

# Wick SR 检测阈值
WICK_RATIO=0.4          # wick 占整 K range 的最小比例(>= 0.4)
LOOKBACK_CANDLES=300     # 拉多少根 K 线做回溯

# 钉钉 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=xxx

# Telegram(可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 报警过滤
ALERT_COOLDOWN_MIN=15    # 同一根 K 的同一侧 SR 报警冷却(分钟)
