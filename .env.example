# ============================================
# K-line 服务器地址
# ============================================

# 本地开发
NEXT_PUBLIC_KLINE_API=http://localhost:3001
NEXT_PUBLIC_KLINE_WS=ws://localhost:3001/ws

# 生产环境示例 (通过 Nginx 反向代理)
# NEXT_PUBLIC_KLINE_API=https://yourdomain.com
# NEXT_PUBLIC_KLINE_WS=wss://yourdomain.com/ws

# ============================================
# 用户认证 (必须配置)
# ============================================

# JWT 密钥 (用于用户登录认证，请使用强随机字符串)
# 生成方式: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# ============================================
# API 密钥加密 (必须配置)
# ============================================

# API 加密密钥 (用于加密存储的交易所 API Secret)
# 必须是 32 字节的十六进制字符串 (64 个字符)
# 生成方式: openssl rand -hex 32
API_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
