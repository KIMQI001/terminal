# ============================================
# K-line 服务器地址
# ============================================

# 本地开发
NEXT_PUBLIC_KLINE_API=http://localhost:3001
NEXT_PUBLIC_KLINE_WS=ws://localhost:3001/ws

# 生产环境示例 (通过 Nginx 反向代理)
# NEXT_PUBLIC_KLINE_API=https://yourdomain.com
# NEXT_PUBLIC_KLINE_WS=wss://yourdomain.com/ws

# ============================================
# 用户认证 (必须配置)
# ============================================

# JWT 密钥 (用于用户登录认证，请使用强随机字符串)
# 生成方式: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# ============================================
# API 密钥加密 (必须配置)
# ============================================

# API 加密密钥 (用于加密存储的交易所 API Secret)
# 必须是 32 字节的十六进制字符串 (64 个字符)
# 生成方式: openssl rand -hex 32
API_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# CoinAnk 清算图服务 (可选)
# ============================================

# CoinAnk 中转服务 HTTP API 地址
# 使用 HTTP 代替 WebSocket 避免 Next.js 中 ws 库的打包问题
# 使用 127.0.0.1 而不是 localhost 避免 IPv6 解析问题
# 本地开发 (默认)
COINANK_RELAY_HTTP=http://127.0.0.1:3001/api/coinank/fetch

# 生产环境示例
# COINANK_RELAY_HTTP=http://127.0.0.1:3001/api/coinank/fetch

# ============================================
# AI 分析服务配置 (analysis-service)
# ============================================

# AI 服务提供商: claude 或 openai
AI_PROVIDER=claude

# Claude API Key
# 获取地址: https://console.anthropic.com/
AI_API_KEY=sk-ant-xxx

# AI 模型 (Claude 推荐 claude-3-sonnet-20240229)
AI_MODEL=claude-3-sonnet-20240229

# 调度间隔 (cron 格式，默认每 15 分钟)
SCHEDULE_INTERVAL=*/15 * * * *

# ============================================
# 钉钉机器人配置
# ============================================

# 钉钉 Webhook URL (不含签名参数)
# 创建方式: 钉钉群 -> 设置 -> 智能群助手 -> 添加机器人 -> 自定义
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 钉钉机器人签名密钥 (安全设置中开启加签)
DINGTALK_SECRET=SEC_xxx
