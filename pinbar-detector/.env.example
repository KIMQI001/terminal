# Binance API 配置
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=false

# 钉钉 Webhook 配置
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=xxx

# 交易参数
FIXED_PROFIT_POINTS=300

# 开仓占账户余额比例 0.0~1.0（默认 0.3 = 30%）
POSITION_PCT=0.3
# 杠杆倍数 1~125（默认 100x）
LEVERAGE=100

# Swing Point 检测长度(默认 20,与前端 15m 一致)
SWING_LENGTH=20
TRAILING_ACTIVATION_POINTS=300
CALLBACK_PROFIT_POINTS=100
# 保护性止损：盈利超过此点数后激活（默认300点）
PROTECTIVE_ACTIVATION_POINTS=300
# 保护性止损：激活后锁定此点数的利润（默认100点）
PROTECTIVE_STOP_POINTS=100